# Shell exports or a gitignored repo-root .env.
# deploy.mjs, deploy-cost.mjs, pin-check.mjs, and run.mjs load .env without overriding the shell.
# The wallet page never reads this file. Never commit secrets or a private key.

# Live simulate/broadcast (deploy.mjs). Exclusive. No private key.
# ETH_RPC=https://ethereum-rpc.publicnode.com
# BASE_RPC=https://mainnet.base.org

# Ethereum fork (run.mjs): ETH_RPC_URL or MAINNET_RPC_URL. Not ETH_RPC.
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# MAINNET_RPC_URL=

# Base fork (run.mjs): BASE_RPC or BASE_RPC_URL.
# BASE_RPC_URL=https://mainnet.base.org
