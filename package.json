{
  "name": "blacksmith-v1-wallet",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node onchain-ui/build.mjs",
    "selfcheck": "node onchain-ui/userop.selfcheck.mjs",
    "test:mcp": "node --test mcp/test/*.test.mjs",
    "test": "node onchain-ui/userop.selfcheck.mjs && node --test mcp/test/*.test.mjs onchain-ui/dev/pin-check.test.mjs onchain-ui/dev/deploy.test.mjs onchain-ui/dev/env.test.mjs && cd onchain-ui/contracts && forge test -vv",
    "test:fork": "node onchain-ui/dev/smoke-fork.mjs",
    "dev:fork": "node onchain-ui/dev/run.mjs",
    "dev:fork:base": "node onchain-ui/dev/run.mjs base",
    "quote:deploy": "node onchain-ui/dev/deploy-cost.mjs",
    "deploy:sim": "node onchain-ui/dev/deploy.mjs",
    "pin": "node onchain-ui/dev/pin-check.mjs",
    "pin:live": "node onchain-ui/dev/pin-check.mjs --live"
  }
}
